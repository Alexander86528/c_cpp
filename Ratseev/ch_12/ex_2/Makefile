# Компилятор
CC = gcc

# Флаги компиляции (можно менять тут, а не в каждой команде)
CFLAGS = -Wall -Wextra -O2

# Имя исполняемого файла
TARGET = bitset

# Исходные файлы
SRCS = main.c bit_utils.c

# Объектные файлы (автоматически получаем из .c → .o)
OBJS = $(SRCS:.c=.o)

# Цель по умолчанию
all: $(TARGET)

# Правило сборки исполняемого файла из объектных
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS)

# Шаблонное правило: как из .c получить .o
%.o: %.c bit_utils.h
	$(CC) $(CFLAGS) -c $< -o $@

# Очистка: удалить объектные и исполняемый файлы
clean:
	rm -f $(OBJS) $(TARGET)

# Помечаем эти цели как «не файлы», чтобы make их запускал всегда
.PHONY: all clean

